# Bridge Manager
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8088
# Mínimo 16 caracteres. El Core envía este valor en X-API-Key / Bearer.
BRIDGE_API_KEY=cambia-esta-clave-bridge

# Core (producción): URL del PHP del Core
# Prueba local sin UI: http://127.0.0.1:8088/api/v1/debug/events
CORE_EVENTS_URL=http://localhost:8000/internal/bridge/events
CORE_API_KEY=cambia-esta-clave-core

# Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Pool de terminales portables
SLOT_COUNT=15
TERMINALS_ROOT=./terminals
DATA_DIR=./data

# Polling del Worker (segundos)
POLL_ACCOUNT_SEC=9
POLL_POSITIONS_SEC=6
POLL_HISTORY_SEC=7
HISTORY_LOOKBACK_DAYS=7

# false = al conectar no se reenvían trade.closed viejos (recomendado)
REPLAY_HISTORY_ON_CONNECT=false

# Lifecycle
WORKER_RESTART_MAX=5
WORKER_RESTART_BACKOFF_SEC=5
LOGIN_RETRY_MAX=4
LOGIN_RETRY_BACKOFF_SEC=8
SHUTDOWN_TIMEOUT_SEC=12
MT5_INIT_TIMEOUT_MS=60000
