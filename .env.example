# Bridge Manager
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8088
# Mínimo 16 caracteres. El Core envía este valor en X-API-Key / Bearer.
BRIDGE_API_KEY=G1TuvbV9cPwHAnD%

# Core (producción): URL del PHP del Core
# Prueba local sin UI: http://127.0.0.1:8088/api/v1/debug/events
CORE_EVENTS_URL=https://mantiscapital.net/internal/bridge/events.php
CORE_API_KEY=551515151515151

# Reintentos por evento antes de darlo por perdido (401/403/404 no se reintentan).
CORE_RETRY_MAX=3
# true solo si el Core únicamente es alcanzable a través del proxy del sistema.
CORE_HTTP_TRUST_ENV=false

# Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Pool de terminales portables
SLOT_COUNT=15
TERMINALS_ROOT=./terminals
DATA_DIR=./data

# Polling del Worker (segundos)
POLL_ACCOUNT_SEC=9
POLL_POSITIONS_SEC=6
POLL_HISTORY_SEC=7
HISTORY_LOOKBACK_DAYS=7
# MT5 filtra el historial por hora del SERVIDOR del bróker, no por UTC.
# Esta holgura evita perder los cierres de las últimas horas. No bajar de 12.
HISTORY_FORWARD_BUFFER_HOURS=24

# false = no se manda el libro de posiciones ABIERTAS al Core. Ponlo a false
# si el Core solo registra operaciones cerradas: evita que rechace eventos que
# no quiere guardar. No afecta a trade.closed.
EMIT_POSITION_EVENTS=true

# false = al conectar no se reenvían trade.closed viejos (recomendado)
REPLAY_HISTORY_ON_CONNECT=true

# Lifecycle
WORKER_RESTART_MAX=5
WORKER_RESTART_BACKOFF_SEC=5
# Segundos entre el arranque de un Worker y el siguiente. Varios terminales
# MT5 levantando a la vez se ahogan (-10005 IPC timeout). No bajar de 15.
WORKER_SPAWN_STAGGER_SEC=25
LOGIN_RETRY_MAX=4
LOGIN_RETRY_BACKOFF_SEC=8
SHUTDOWN_TIMEOUT_SEC=12
MT5_INIT_TIMEOUT_MS=60000
# Cambiar de bróker tarda más de un minuto (descarga del servidor nuevo y
# sincronización de símbolos). Si los slots se clonan de una plantilla con
# otro bróker dentro, no bajar de 120000.
MT5_LOGIN_TIMEOUT_MS=180000
MT5_LOGIN_ATTEMPTS=3
# Al cambiar de bróker, MT5 tira el canal IPC y login() falla al instante
# aunque el terminal sí entre. Esto es lo que se espera antes de reenganchar
# y comprobar quién está dentro.
MT5_REATTACH_WAIT_SEC=20
